# Python-generated files
__pycache__/
.pytest_cache/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
.venv.stale-*/

# Secrets et donnees personnelles (ne JAMAIS versionner)
config.yaml
desktop_agent/config.yaml
desktop_agent/.venv/
desktop_agent/logs/
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
contenus.yaml
budget.json
memoire.json
memory.json
google_credentials.json
google_token.json*
notes/
reminders.json
satellite_pi/config.yaml
# Certificat et cle TLS du listener LAN (la cle ne quitte jamais le serveur)
certs/
desktop_agent/*.crt
satellite_pi/*.crt
# Filets de securite si un dossier de session est deplace hors de logs/
# (alexa.dossier, spotify.dossier, instagram.dossier...).
*.cookies
cookies*.json
*.oauth.json
token.json
tokens.json
credentials*.json
*.log
*.sqlite
*.db

# Journaux
logs/

# Editions personnelles generees (JSON, HTML, PDF et rendus QA)
output/
tmp/
.uv-cache/

# Consignes locales d'agents IA (non versionnees)
AGENTS.md
.codex/

# Profil navigateur persistant des reservations (cookies, sessions connectees)
.profil_reservation/

# Config locale de l'outil Claude Code (contient des chemins personnels)
.claude/

# Modeles de voix Piper : trop lourds pour GitHub, a retelecharger.
# Voir README pour le lien de telechargement.
voix/

# Gestes : venv isole (Python 3.11 + MediaPipe), modele et calibration locale.
gestes/.venv-tracker/
gestes/models/
gestes/calibration.json

# Musique : venv isole (Python 3.12 + shazamio) et captures audio temporaires.
musique/.venv-shazam/
musique/captures/

# Cockpit : donnees financieres PERSO (tout le dossier sauf l'exemple versionne).
finances/*
!finances/abonnements.example.yaml

# Pack de configuration Claude Code temporaire (supprime apres installation)
_claude-setup/

# Copies de sauvegarde des fichiers de secrets : copie de l'Explorateur
# ("config - Copie.yaml"), .bak, .old... sauvegarder_jarvis.bat fait un
# "git add -A" : sans ces filets, une copie de config.yaml partirait sur GitHub.
config*.yaml
config*.yml
*.bak
*.old
*.orig
*- Copie*
*- Copy*
Copie de *
*.env
*.crt
CLAUDE.local.md
# Temporaires d'ecriture atomique (.config.yaml.XXXX.tmp, .memory.json.XXXX.tmp,
# .contenus.yaml.XXXX.tmp) : laisses par un arret brutal, ils contiennent des
# secrets ou des donnees personnelles. Copies de la memoire, par prudence.
.*.tmp
memory.json.*
# Exemples publics versionnes : negations TOUJOURS en dernier (attention a
# l'orthographe francaise de satellite_pi/config.exemple.yaml).
!config.example.yaml
!desktop_agent/config.example.yaml
!satellite_pi/config.exemple.yaml
